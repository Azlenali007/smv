# ----------------------------------------------------------------------
# ApexPulse SMM Panel - Root Directory Apache Configuration
# Dual Web Root Support (Project Root & Public Directory Environments)
# ----------------------------------------------------------------------

# 1. Disable directory browsing
Options -Indexes

<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

# 2. Block direct browser access to hidden files (.env, .git, etc.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Block direct browser access to sensitive system & build files
<FilesMatch "(composer\.(json|lock)|package(-lock)?\.json|bun\.lock|vite\.config\.js|metadata\.json|spark|\.env.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 4. URL Rewriting to CodeIgniter Front Controller
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct browser access to backend source & storage directories
    RewriteRule ^(app|system|writable|vendor|resources|tests)/ - [F,L,NC]

    # Ensure Authorization header is passed to PHP
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Allow direct access to existing static files in public/assets or public/
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -d
    RewriteRule ^(.*)$ public/$1 [L]

    # Map public asset subdirectories directly for root installations
    RewriteRule ^assets/(.*)$ public/assets/$1 [L]
    RewriteRule ^dist/(.*)$ public/dist/$1 [L]
    RewriteRule ^build/(.*)$ public/build/$1 [L]
    RewriteRule ^resources/css/(.*)$ public/assets/css/$1 [L]
    RewriteRule ^favicon\.ico$ public/favicon.ico [L]
    RewriteRule ^robots\.txt$ public/robots.txt [L]

    # Avoid recursive rewriting if request is already targeting public/
    RewriteCond %{REQUEST_URI} ^/public/
    RewriteRule ^ - [L]

    # Handle Front Controller for all application routes:
    # /, /install, /install/*, /login, /dashboard, /admin, /register, etc.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([\s\S]*)$ public/index.php/$1 [L,NC,QSA]
</IfModule>

<IfModule !mod_rewrite.c>
    ErrorDocument 404 public/index.php
</IfModule>

# Disable server signature
ServerSignature Off
